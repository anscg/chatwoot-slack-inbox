# --- Hub Slack app: admin sign-in, /link and user lookups. ---
# Start the server first, then download its pre-filled manifest from ${PUBLIC_URL}/setup and create the app from it.
SLACK_BOT_TOKEN=xoxb-placeholder         # OAuth & Permissions > Bot User OAuth Token
SLACK_CLIENT_ID=placeholder              # Basic Information > App Credentials
SLACK_CLIENT_SECRET=placeholder
# Each bridge has its OWN Slack app (bot token + signing secret), configured in the control panel.

# --- Chatwoot ---
CHATWOOT_BASE_URL=https://app.chatwoot.com   # no trailing slash; one installation, any number of accounts
CHATWOOT_WEBHOOK_SECRET=                     # random, >= 16 chars. Webhook URL: ${PUBLIC_URL}/webhooks/chatwoot/${CHATWOOT_WEBHOOK_SECRET}

# --- Control panel ---
ADMIN_SLACK_USER_IDS=U0123456789,U0987654321  # Slack user IDs allowed to sign in at ${PUBLIC_URL}/admin/

# --- App ---
DATABASE_URL=postgres://chatwoot_slack:chatwoot_slack@localhost:5432/chatwoot_slack
TOKEN_ENCRYPTION_KEY=                    # 32 bytes, base64 or hex: openssl rand -base64 32
PUBLIC_URL=https://bridge.example.com    # publicly reachable, no trailing slash
PORT=3000
LOG_LEVEL=info
